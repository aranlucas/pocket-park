{
  "name": "pocket-park",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "portless run vite",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "npm run typecheck && vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "check": "npm run lint && npm run test && npm run build",
    "lint": "oxlint ."
  },
  "dependencies": {
    "@fontsource/fraunces": "5.3.0",
    "planck": "1.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "oxlint": "1.86.0",
    "@oxlint/plugins": "1.86.0",
    "portless": "0.15.7"
  }
}
